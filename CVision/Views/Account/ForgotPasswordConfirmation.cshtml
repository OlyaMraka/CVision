@{
    ViewData["Title"] = "Лист надіслано";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/LadingPage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="hero" style="display:flex;align-items:center;justify-content:center;">
    <div class="modal-overlay is-open" id="forgotPasswordConfirmationOverlay">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="forgotPasswordConfirmationTitle">
            <button class="modal__close" type="button" onclick="window.location.href='/'" aria-label="Закрити">
                &#x2715;
            </button>

            <h1 class="modal__title" id="forgotPasswordConfirmationTitle">Перевірте пошту</h1>
            <p class="modal__subtitle">
                Якщо акаунт з таким email існує, ми вже надіслали інструкції для скидання пароля.
            </p>

            <a class="btn-auth" asp-controller="Account" asp-action="Login"
                   style="text-decoration:none;display:flex;align-items:center;justify-content:center;">
                Повернутися до входу
            </a>
        </div>
    </div>
</div>
