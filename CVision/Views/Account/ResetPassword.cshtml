@model CVision.Models.ViewModels.AuthViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Скидання пароля";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/LadingPage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="hero" style="display:flex;align-items:center;justify-content:center;">
    <div class="modal-overlay is-open" id="resetPasswordOverlay">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="resetPasswordTitle">
            <button class="modal__close" type="button" onclick="window.location.href='/'" aria-label="Закрити">
                &#x2715;
            </button>

            <h1 class="modal__title" id="resetPasswordTitle">Новий пароль</h1>
            <p class="modal__subtitle">Встановіть новий пароль для вашого акаунта</p>

            <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                @Html.AntiForgeryToken()

                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="form-alert form-alert--error" role="alert"></div>

                <div class="form-group">
                    <label class="form-group__label" asp-for="NewPassword">Новий пароль</label>
                    <div class="form-group__input-wrap">
                        <span class="form-group__icon-left" aria-hidden="true">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                        </span>
                        <input asp-for="NewPassword" id="newPassword" class="form-group__input" type="password"
                               placeholder="Мінімум 8 символів" autocomplete="new-password" />
                        <button class="form-group__toggle-pass" type="button"
                                onclick="togglePassword('newPassword', this)" aria-label="Показати пароль">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path
                                d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8 a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8 a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="form-group__error"></span>
                </div>

                <div class="form-group">
                    <label class="form-group__label" asp-for="ConfirmPassword">Підтвердження пароля</label>
                    <div class="form-group__input-wrap">
                        <span class="form-group__icon-left" aria-hidden="true">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                        </span>
                        <input asp-for="ConfirmPassword" id="confirmPassword" class="form-group__input" type="password"
                               placeholder="Повторіть пароль" autocomplete="new-password" />
                        <button class="form-group__toggle-pass" type="button"
                                onclick="togglePassword('confirmPassword', this)" aria-label="Показати пароль">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path
                                d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8 a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8 a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="form-group__error"></span>
                </div>

                <button class="btn-auth" type="submit">Змінити пароль</button>
            </form>

            <p class="modal__footer-text" style="margin-top:1.2rem;">
                <a asp-controller="Account" asp-action="Login">Повернутися до входу</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            btn.innerHTML = isHidden
                ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                         <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                         <circle cx="12" cy="12" r="3"/>
                       </svg>`
                : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                         <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8 a18.45 18.45 0 0 1 5.06-5.94"/>
                         <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8 a18.5 18.5 0 0 1-2.16 3.19"/>
                         <line x1="1" y1="1" x2="23" y2="23"/>
                       </svg>`;
        }
    </script>
}
