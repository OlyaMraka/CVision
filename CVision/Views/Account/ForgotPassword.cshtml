@model CVision.Models.ViewModels.AuthViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Відновлення пароля";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Account/log-in-form.css" asp-append-version="true" />
}

<div class="hero" style="display:flex;align-items:center;justify-content:center;">
    <div class="modal-overlay is-open" id="forgotPasswordOverlay">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="forgotPasswordTitle">
            <button class="modal__close" type="button" onclick="window.location.href='/'" aria-label="Закрити">
                &#x2715;
            </button>

            <h1 class="modal__title" id="forgotPasswordTitle">Відновлення пароля</h1>
            <p class="modal__subtitle">Введіть email, і ми надішлемо посилання для скидання пароля</p>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="form-alert form-alert--error" role="alert"></div>

                <div class="form-group">
                    <label class="form-group__label" asp-for="Email">Електронна пошта</label>
                    <div class="form-group__input-wrap">
                        <span class="form-group__icon-left" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="4" width="20" height="16" rx="2" />
                                <path d="m2 7 10 7 10-7" />
                            </svg>
                        </span>
                        <input asp-for="Email" class="form-group__input form-group__input--no-right" type="email"
                               placeholder="name@example.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="form-group__error"></span>
                </div>

                <button class="btn-auth" type="submit">Надіслати посилання</button>
            </form>

            <p class="modal__footer-text" style="margin-top:1.2rem;">
                Згадали пароль?
                <a asp-controller="Account" asp-action="Login">Повернутися до входу</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
