@using CVision.Helpers.Constants
@model IEnumerable<CVision.Models.ViewModels.CVAnalysisViewModels.VacancyViewModel>

<div class="vacancies-grid">
    @if (Model.Any())
    {
        foreach (var vacancy in Model)
        {
            <div class="vacancy-card">
                <div class="vacancy-top">
                    <span class="vacancy-source">@vacancy.Source</span>
                    <h4 class="vacancy-title">@vacancy.Title</h4>
                    <p class="vacancy-company">@vacancy.Company</p>
                </div>
                <div class="vacancy-footer">
                    <a href="@vacancy.Url" target="_blank" class="btn-vacancy-link">
                        Відгукнутися
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                        </svg>
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <p class="no-vacancies">@CvAnalysisDetails.NoVacancies</p>
    }
</div>
