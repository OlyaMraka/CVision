@using CVision.Helpers
@using CVision.Helpers.Constants
@model CVision.Models.ViewModels.CVAnalysisViewModels.CVGalleryPageViewModel

@{
    ViewData["Title"] = "Галерея CV";
    ViewData["DashboardCurrentPage"] = "gallery";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HubUser.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/css/CvAnalysis/CVGallery.css" asp-append-version="true" />
}

<div class="gallery-page">
    <div class="gallery-page__gradient"></div>
    <partial name="~/Views/Shared/_DashboardHeader.cshtml" />

    <main class="gallery-content">

        @if (Model?.Items == null || !Model.Items.Any())
        {
            <div class="gallery-empty">
                <div class="gallery-empty__icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="12" y1="13" x2="12" y2="17"/>
                        <line x1="10" y1="15" x2="14" y2="15"/>
                    </svg>
                </div>
                <p class="gallery-empty__title">@CvGalleryConstants.NoResume</p>
                <p class="gallery-empty__text">@CvGalleryConstants.FirstLoud</p>
            </div>
        }
        else
        {
            <div class="gallery-grid">
                @foreach (var item in Model.Items)
                {
                    <div class="resume-card">

                        <div class="resume-card__actions">
                            <a asp-controller="CvAnalysis"
                               asp-action="ConfirmDelete"
                               asp-route-id="@item.Id"
                               class="resume-card__delete-btn"
                               title="Видалити CV">
                                <img src="~/images/delete.png" alt="Видалити" class="resume-card__delete-icon" />
                            </a>
                        </div>

                        <div class="resume-card__preview">
                            @{
                                var url = item.FileUrl ?? "";
                                var isImage = url.EndsWith(".png",  StringComparison.OrdinalIgnoreCase)
                                           || url.EndsWith(".jpg",  StringComparison.OrdinalIgnoreCase)
                                           || url.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase);
                                var isPdf = url.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                var isDoc = url.EndsWith(".doc",  StringComparison.OrdinalIgnoreCase)
                                         || url.EndsWith(".docx", StringComparison.OrdinalIgnoreCase);
                            }

                            @if (isImage)
                            {
                                <img src="@url" alt="CV #@item.Id" class="resume-card__preview-img" />
                            }
                            else if (isPdf)
                            {
                                <iframe src="@Url.Content(url)" class="resume-card__preview-frame"></iframe>
                            }
                            else if (isDoc)
                            {
                                <iframe src="https://view.officeapps.live.com/op/embed.aspx?src=@url"
                                        class="resume-card__preview-frame"></iframe>
                            }
                            else
                            {
                                <div class="resume-card__preview-placeholder">
                                    <span>@CvGalleryConstants.UnknownContent</span>
                                </div>
                            }
                        </div>

                        <div class="resume-card__body">
                            <h3 class="resume-card__title">Резюме #@item.Id</h3>
                            <p class="resume-card__feedback">@item.ShortFeedBack</p>
                            <a asp-controller="CvAnalysis"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="resume-card__details-link">
                                @CvGalleryConstants.Detailsss
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2.5"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12h14M12 5l7 7-7 7"/>
                                </svg>
                            </a>
                        </div>

                    </div>
                }
            </div>
        }

    </main>
</div>

@section Scripts {
    <script src="~/js/CvAnalysis/HubGallery.js" asp-append-version="true"></script>
}
