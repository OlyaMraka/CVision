@using CVision.Helpers;
@using CVision.Helpers.Constants

@model CVision.Models.ViewModels.CvForum.PublicationsViewModel

@{
    ViewData["Title"] = "CV Форум";
    ViewData["DashboardCurrentPage"] = "CvForum";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HubUser.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CvForum/publication-page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CvForum/add-comment.css" asp-append-version="true" />
}

<div class="publication-info-block">
    <partial name="~/Views/Shared/_DashboardHeader.cshtml" />   
    
    <div class="main-info-block">
        <div class="file-preview-container">
            @{
                var fileUrl = Model.FilePath;
            }

            @if (FileUtils.IsImage(fileUrl))
            {
                <img src="@fileUrl" class="img-fluid"/>
            }
            else if (FileUtils.IsDocx(fileUrl))
            {
                var encodedUrl = System.Net.WebUtility.UrlEncode(fileUrl);
                <iframe src="https://view.officeapps.live.com/op/embed.aspx?src=@encodedUrl"></iframe>
            }
            else if (FileUtils.IsPdf(fileUrl))
            {
                <iframe src="@fileUrl#toolbar=0"></iframe>
            }
            else
            {
                <div class="alert alert-secondary">@CvAnalysisConstants.UnavailablePreview</div>
            }
        </div>
        
        <div class="main-content-block">
            <div class="main-content-header">
                <h1 class="main-content-title">@Model.Title</h1>
                @if (Model.IsOwn)
                {
                    <div class="operations-block">
                        <a asp-controller="Publication"
                           asp-action="EditPublication"
                           asp-route-publicationId="@Model.Id" class="operation-btn">
                            <i class="fa-regular fa-pen-to-square"></i>
                        </a>
                        <a asp-controller="Publication"
                           asp-action="ConfirmDelete"
                           asp-route-publicationId="@Model.Id" class="operation-btn">
                            <i class="fa-regular fa-trash-can"></i>
                        </a>
                    </div>
                }
            </div>
            
            <div class="main-content-description">
                <p>@Model.Description</p>
            </div>
        </div>
        
        <div class="discussion-block">
            <div class="discussion-header">
                <h2>Коментарі:</h2>
        
                <button type="button" class="btn-open-comment" id="btnOpenEditor" onclick="showCommentForm()">
                    <i class="fa-solid fa-comment-dots"></i> Додати коментар
                </button>
            </div>

            <div class="comments-list">
            </div>

            <partial name="~/Views/CvForum/components/AddComment.cshtml" 
                     model="new CVision.Models.ViewModels.CvForum.CreateCommentViewModel { PublicationId = Model.Id }" />
        </div>
    </div>
</div>
