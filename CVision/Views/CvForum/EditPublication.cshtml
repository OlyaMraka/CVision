@model CVision.Models.ViewModels.CvForum.PublicationsViewModel

@{
    ViewData["Title"] = "CV Форум";
    ViewData["DashboardCurrentPage"] = "CvForum";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HubUser.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CvForum/edit-page.css" asp-append-version="true" />
}

<div class="edit-block">
    <partial name="~/Views/Shared/_DashboardHeader.cshtml" />
    
    <form asp-controller="Publication" asp-action="EditPublication" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label>Назва допису</label>
            <input asp-for="Title" class="form-control" type="text" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Опис</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="operations-block">
            <button type="submit" class="btn-save">Зберегти зміни</button>
            <a asp-controller="Publication"
               asp-action="GetPublication"
               asp-route-publicationId="@Model.Id">Скасувати</a>
        </div>
    </form>
</div>
