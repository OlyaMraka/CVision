@using CVision.Helpers.Constants
@model CVision.Models.ViewModels.CvForum.CreateCommentViewModel

<div class="comment-editor-box" id="commentEditor" style="display: none; margin-top: 1rem;">
    <form asp-controller="Publication" asp-action="AddComment" method="post">
        <input type="hidden" asp-for="PublicationId" />
        <input type="hidden" asp-for="ParentCommentId" />
        
        <div class="textarea-wrapper">
            <textarea asp-for="Content" placeholder="Ваш відгук про це CV..." class="comment-input" required></textarea>
        </div>
        
        <div class="editor-actions">
            <button type="button" class="btn-close-editor" onclick="hideCommentForm()">Скасувати</button>
            <button type="submit" class="btn-send-comment">Надіслати</button>
        </div>
    </form>
</div>
<script>
    const commentUiConfig = {
        updateUrl: '@Url.Content("~/api/Comments/update")',
        deleteUrlBase: '@Url.Content("~/api/Comments/delete")',
        errorUrl: '@Url.Action("ShowError", "Publication")',
        deleteConfirmMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PublicationConstants.DeleteCommentConfirmation)),
        emptyCommentMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PublicationConstants.CommentContentRequiredMessage)),
        minLengthMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PublicationConstants.CommentMinLengthErrorMessage)),
        maxLengthMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PublicationConstants.CommentMaxLengthErrorMessage)),
        commentNotFoundMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PublicationConstants.CommentNotFoundMessage)),
        saveCommentErrorMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PublicationConstants.SaveCommentErrorMessage)),
        deleteCommentErrorMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PublicationConstants.DeleteCommentErrorMessage)),
        commentActionError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PublicationConstants.CommentActionError)),
        minCommentLength: @PublicationConstants.CommentMinLength,
        maxCommentLength: @PublicationConstants.CommentMaxLength
    };

    function getCommentResultValue(result, camelCaseKey, pascalCaseKey) {
        if (!result || typeof result !== 'object') {
            return undefined;
        }

        if (camelCaseKey in result) {
            return result[camelCaseKey];
        }

        if (pascalCaseKey in result) {
            return result[pascalCaseKey];
        }

        return undefined;
    }

    function isCommentActionFailed(result) {
        const isSuccess = getCommentResultValue(result, 'isSuccess', 'IsSuccess');

        if (typeof isSuccess === 'boolean') {
            return !isSuccess;
        }

        return Boolean(
            getCommentResultValue(result, 'error', 'Error') ||
            getCommentResultValue(result, 'detail', 'Detail') ||
            getCommentResultValue(result, 'title', 'Title')
        );
    }

    function hideAllInlineCommentEditors() {
        document.querySelectorAll('[id^="commentEditBox-"]').forEach(box => {
            box.style.display = 'none';
        });

        document.querySelectorAll('[id^="commentContent-"]').forEach(content => {
            content.style.display = 'block';
        });
    }

    function showCommentForm() {
        hideAllInlineCommentEditors();

        const editor = document.getElementById('commentEditor');
        const btn = document.getElementById('btnOpenEditor');
        
        if (editor && btn) {
            const parentInput = document.querySelector('input[name="ParentCommentId"]');
            if (parentInput) parentInput.value = "";
            
            const textarea = editor.querySelector('textarea');
            textarea.placeholder = "Ваш відгук про це CV...";
            
            editor.style.display = 'block';
            btn.style.display = 'none';
            textarea.focus();
        }
    }

    function showReplyForm(commentId, authorName) {
        hideAllInlineCommentEditors();

        const editor = document.getElementById('commentEditor');
        const btn = document.getElementById('btnOpenEditor');
        const parentInput = document.querySelector('input[name="ParentCommentId"]');
        const textarea = editor.querySelector('textarea');

        if (editor && parentInput) {
            parentInput.value = commentId;
            textarea.placeholder = `Відповідь для ${authorName}...`;

            editor.style.display = 'block';
            if (btn) btn.style.display = 'none';
            textarea.focus();
        }
    }

    function hideCommentForm() {
        const editor = document.getElementById('commentEditor');
        const btn = document.getElementById('btnOpenEditor');

        if (editor) editor.style.display = 'none';
        if (btn) btn.style.display = 'flex';
    }

    function startCommentEdit(commentId) {
        hideCommentForm();
        hideAllInlineCommentEditors();

        const contentBlock = document.getElementById(`commentContent-${commentId}`);
        const editBox = document.getElementById(`commentEditBox-${commentId}`);
        const input = document.getElementById(`commentEditInput-${commentId}`);

        if (!contentBlock || !editBox || !input) {
            redirectToCommentError(commentUiConfig.commentNotFoundMessage);
            return;
        }

        contentBlock.style.display = 'none';
        editBox.style.display = 'block';
        input.focus();
        input.setSelectionRange(input.value.length, input.value.length);
    }

    function cancelCommentEdit(commentId) {
        const contentBlock = document.getElementById(`commentContent-${commentId}`);
        const editBox = document.getElementById(`commentEditBox-${commentId}`);
        const input = document.getElementById(`commentEditInput-${commentId}`);
        const text = document.getElementById(`commentText-${commentId}`);

        if (input && text) {
            input.value = text.textContent.trim();
        }

        if (contentBlock) contentBlock.style.display = 'block';
        if (editBox) editBox.style.display = 'none';
    }

    function redirectToCommentError(message) {
        const errorMessage = message || commentUiConfig.commentActionError;
        const returnUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;

        window.location.href = `${commentUiConfig.errorUrl}?message=${encodeURIComponent(errorMessage)}&returnUrl=${encodeURIComponent(returnUrl)}`;
    }

    function getCommentActionError(result, fallbackMessage) {
        const errorMessage =
            getCommentResultValue(result, 'error', 'Error') ??
            getCommentResultValue(result, 'detail', 'Detail') ??
            getCommentResultValue(result, 'title', 'Title');

        if (typeof errorMessage === 'string' && errorMessage.trim().length > 0) {
            return errorMessage;
        }

        return fallbackMessage || commentUiConfig.commentActionError;
    }

    async function submitCommentEdit(commentId) {
        const input = document.getElementById(`commentEditInput-${commentId}`);

        if (!input) {
            redirectToCommentError(commentUiConfig.commentNotFoundMessage);
            return;
        }

        const content = input.value.trim();

        if (!content) {
            redirectToCommentError(commentUiConfig.emptyCommentMessage);
            return;
        }

        if (content.length < commentUiConfig.minCommentLength) {
            redirectToCommentError(commentUiConfig.minLengthMessage);
            return;
        }

        if (content.length > commentUiConfig.maxCommentLength) {
            redirectToCommentError(commentUiConfig.maxLengthMessage);
            return;
        }

        try {
            const response = await fetch(commentUiConfig.updateUrl, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    id: commentId,
                    content
                })
            });

            const result = await response.json().catch(() => null);

            if (!response.ok || isCommentActionFailed(result)) {
                redirectToCommentError(getCommentActionError(result, commentUiConfig.saveCommentErrorMessage));
                return;
            }

            window.location.reload();
        } catch {
            redirectToCommentError(commentUiConfig.saveCommentErrorMessage);
        }
    }

    async function deleteComment(commentId) {
        const normalizedCommentId = Number(commentId);

        if (!Number.isInteger(normalizedCommentId) || normalizedCommentId <= 0) {
            redirectToCommentError(commentUiConfig.commentNotFoundMessage);
            return;
        }

        const isConfirmed = window.confirm(commentUiConfig.deleteConfirmMessage);

        if (!isConfirmed) {
            return;
        }

        try {
            const response = await fetch(`${commentUiConfig.deleteUrlBase}/${normalizedCommentId}`, {
                method: 'DELETE'
            });

            const result = await response.json().catch(() => null);

            if (!response.ok || isCommentActionFailed(result)) {
                redirectToCommentError(getCommentActionError(result, commentUiConfig.deleteCommentErrorMessage));
                return;
            }

            window.location.reload();
        } catch {
            redirectToCommentError(commentUiConfig.deleteCommentErrorMessage);
        }
    }
</script>