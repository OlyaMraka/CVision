@{
    string currentPage = (string?)ViewData["DashboardCurrentPage"] ?? string.Empty;
}

<header class="dashboard-header">
    <a asp-controller="Home" asp-action="tips" class="dashboard-header__logo">CVision</a>

    <nav class="dashboard-nav" aria-label="Основна навігація">
        <a class="dashboard-nav__item @(currentPage == "CvAnalysis" ? "is-active" : string.Empty)"
               asp-controller="CvAnalysis" asp-action="Analyze">
            Аналіз резюме
        </a>
        <a class="dashboard-nav__item @(currentPage == "gallery" ? "is-active" : "")" asp-controller="CvAnalysis"
           asp-action="CVGallery">
            Переглянути резюме
        </a>
        <a class="dashboard-nav__item @(currentPage == "Analytics" ? "is-active" : "")" 
           asp-controller="Analytics" asp-action="SalaryAnalytics">
            Аналітика ринку праці
        </a>
        <a class="dashboard-nav__item @(currentPage == "Basket" ? "is-active" : "")" asp-controller="Basket"
               asp-action="Index" title="Переглянути видалені CV">
            Кошик
        </a>
        <a class="dashboard-nav__item @(currentPage == "CvForum" ? "is-active" : "")" asp-controller="Publication" asp-action="CvForum">
            Форум натхнення
        </a>
        
    </nav>

    <div class="dashboard-header__actions">
        <a asp-controller="Home" asp-action="user"
               class="dashboard-header__user @(currentPage == "user" ? "is-active" : string.Empty)"
               aria-label="Профіль користувача">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 2.25c-4.14 0-7.5 2.77-7.5 6.19 0 .31.25.56.56.56h13.88c.31 0 .56-.25.56-.56 0-3.42-3.36-6.19-7.5-6.19Z" />
            </svg>
        </a>

        <button id="chatToggleBtn" class="chat-toggle-btn" onclick="chatSidebar.toggle()" aria-label="Відкрити чат" title="Повідомлення">
            <i class="fa-regular fa-comment-dots"></i>
            <span id="chatUnreadBadge" class="chat-badge" style="display:none;"></span>
        </button>

        <button id="notifToggleBtn" class="notif-toggle-btn" aria-label="Сповіщення" title="Сповіщення">
            <i class="fa-regular fa-bell"></i>
            <span id="notifBadge" class="notif-badge" style="display:none;"></span>
        </button>
    </div>
</header>
