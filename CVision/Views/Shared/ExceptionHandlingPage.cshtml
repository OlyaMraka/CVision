@model CVision.Models.ViewModels.ExceptionHandlingViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/exception-handling-page.css" asp-append-version="true" />
}

<div class="exception-block">
    <div class="status-block">
        <span>@Model.StatusCode</span>
    </div>
    <div class="additional-message-block">
        <span>@Model.Message</span>
    </div>
</div>
