@model CVision.Models.ViewModels.CVForumViewModels.CVForumPostViewModel

<article class="forum-card">
    <div class="forum-card__header">
        <div class="forum-card__avatar" aria-hidden="true">
            @(Model.AuthorName.Length > 0
                ? string.Concat(Model.AuthorName.Split(' ').Take(2).Select(w => w[0].ToString().ToUpper()))
                : "CV")
        </div>

        <div class="forum-card__author">
            <div class="forum-card__author-name">@Model.AuthorName</div>
            @if (!string.IsNullOrEmpty(Model.AuthorRole))
            {
                <div class="forum-card__author-role">@Model.AuthorRole</div>
            }
        </div>
        @if (Model.IsOwner)
        {
            <span class="forum-card__owner-badge">Моє</span>
        }
    </div>
    
    <h3 class="forum-card__title">@Model.Title</h3>
    <p class="forum-card__description">@Model.ShortDescription</p>
    
    <div class="forum-card__footer">
        <div class="forum-card__stats">
            <span class="forum-card__stat">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
                @Model.Views
            </span>
            <span class="forum-card__stat">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                @Model.Comments
            </span>
            <span class="forum-card__stat forum-card__stat--label">Коментарі</span>
        </div>

        <a asp-controller="CVForum"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="forum-card__btn">
            Переглянути
        </a>
    </div>

</article>
@section Scripts {
    <script>
    document.querySelectorAll(".forum-card").forEach(card => {
        card.addEventListener("click", () => {
            const link = card.querySelector(".forum-card__btn");
            if (link) link.click();
        });
    });
</script>
}
