@model CVision.Models.ViewModels.ProfileViewModels.UserWindowViewModel

@{
    ViewData["Title"] = "User Window";
    ViewData["DashboardCurrentPage"] = "user";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string? successMessage = TempData["UserWindowSuccess"] as string;
    string? errorMessage = TempData["UserWindowError"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/HubUser.css" asp-append-version="true" />
}

<div class="dashboard-page dashboard-page--user">
    <div class="dashboard-page__gradient"></div>

    <partial name="~/Views/Shared/_DashboardHeader.cshtml" />

    <main class="dashboard-main dashboard-main--user">
        <section class="dashboard-panel dashboard-panel--profile-spacer">
            <span class="dashboard-card-eyebrow">Редагування профілю</span>
            <h1 class="dashboard-profile-preview__name">Дані користувача</h1>
            <p class="dashboard-profile-preview__text">
                Оновіть свої контактні дані та збережіть зміни.
            </p>

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="dashboard-alert dashboard-alert--success" role="status">
                    @successMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="dashboard-alert dashboard-alert--error" role="alert">
                    @errorMessage
                </div>
            }

            <form asp-controller="Home" asp-action="user" method="post" class="dashboard-form">
                <div asp-validation-summary="ModelOnly" class="dashboard-form__summary"></div>

                <div class="dashboard-field-grid">
                    <div class="dashboard-field dashboard-field--full">
                        <label asp-for="UserName" class="dashboard-field__label"></label>
                        <input asp-for="UserName" class="dashboard-field__input" autocomplete="name" minlength="4"
                               maxlength="40" />
                        <span asp-validation-for="UserName" class="dashboard-field__error"></span>
                    </div>

                    <div class="dashboard-field">
                        <label asp-for="Email" class="dashboard-field__label"></label>
                        <input asp-for="Email" class="dashboard-field__input" autocomplete="email" minlength="4"
                               maxlength="40" />
                        <span asp-validation-for="Email" class="dashboard-field__error"></span>
                    </div>

                    <div class="dashboard-field">
                        <label asp-for="PhoneNumber" class="dashboard-field__label"></label>
                        <input asp-for="PhoneNumber" class="dashboard-field__input" autocomplete="tel" maxlength="20" />
                        <span asp-validation-for="PhoneNumber" class="dashboard-field__error"></span>
                    </div>
                </div>

                <div class="dashboard-form__footer">
                    <div class="dashboard-member-since">
                        <span class="dashboard-member-since__label">Користувач з</span>
                        <span class="dashboard-member-since__value">@Model.MemberSince</span>
                    </div>

                    <button type="submit" class="dashboard-submit-btn">Зберегти зміни</button>
                </div>
            </form>
        </section>

        <aside class="dashboard-panel dashboard-panel--preview">
            <div class="dashboard-account-card">
                <div class="dashboard-account-card__image-wrap dashboard-account-card__image-wrap--black">
                    <img src="~/images/user_1.png" asp-append-version="true" alt="Зображення профілю користувача"
                         class="dashboard-account-card__image" />
                </div>

                <div class="dashboard-account-card__body">
                    <span class="dashboard-card-eyebrow">Профіль</span>
                    <h2>@Model.UserName</h2>
                    <p>@Model.StatusLabel</p>

                    <dl class="dashboard-account-card__meta">
                        <div>
                            <dt>Email</dt>
                            <dd>@Model.Email</dd>
                        </div>
                        <div>
                            <dt>Номер телефону</dt>
                            <dd>@Model.PhoneNumber</dd>
                        </div>
                    </dl>

                    <div class="dashboard-account-card__actions">
                        <a asp-controller="Account" asp-action="Logout" class="dashboard-logout-btn">
                            Вийти з акаунту
                        </a>
                    </div>
                </div>
            </div>
        </aside>
    </main>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}