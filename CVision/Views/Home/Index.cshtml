    </nav>

    <div class="site-header__right">
        <a asp-controller="Account" asp-action="Login" class="btn-login">Увійти</a>
        <a asp-controller="Account" asp-action="Register" class="btn-signup">Зареєструватися</a>
    </div>
</header>

