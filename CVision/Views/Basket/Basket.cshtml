@model CVision.Models.ViewModels.CVBasketViewModels.CVBasketViewModel

@{
    ViewData["Title"] = "Кошик";
    ViewData["DashboardCurrentPage"] = "Basket";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HubUser.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CVGallery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Basket/basket.css" asp-append-version="true" />
}

<div class="dashboard-page dashboard-page--hub">
    <div class="dashboard-page__gradient"></div>
    <partial name="~/Views/Shared/_DashboardHeader.cshtml" />

    <main class="hub">
        <div class="cv-gallery">
            <div class="cv-gallery__header">
                <h2>Мій кошик</h2>
                <p>Файли тут зберігаються до повного видалення. Ви можете переглянути їх перед очищенням.</p>
            </div>

            @if (Model?.Items == null || !Model.Items.Any())
            {
                <div class="cv-gallery__empty">
                    <div class="cv-gallery__empty-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                    </div>
                    <div class="cv-gallery__empty-title">Кошик порожній</div>
                </div>
            }
            else
            {
                <div class="cv-gallery__grid">
                    @foreach (var item in Model.Items)
                    {
                        <div class="cv-card-item cv-card-item--trash">
                            
                            <div class="cv-card-item__preview cv-card-item__preview--trash">
                                @{
                                    var url = item.FilePath ?? "";
                                    var isImage = url.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
                                                  || url.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase)
                                                  || url.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase);
                                    var isPdf = url.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                    var isDoc = url.EndsWith(".doc", StringComparison.OrdinalIgnoreCase)
                                                || url.EndsWith(".docx", StringComparison.OrdinalIgnoreCase);
                                }

                                @if (isImage)
                                {
                                    <img src="@url" alt="CV #@item.Id" class="cv-card-item__img"/>
                                }
                                else if (isPdf)
                                {
                                    <iframe src="@Url.Content(url)" class="cv-card-item__pdf"></iframe>
                                }
                                else if (isDoc)
                                {
                                    <iframe src="https://view.officeapps.live.com/op/embed.aspx?src=@url" class="cv-card-item__doc"></iframe>
                                }
                                else
                                {
                                    <div class="cv-card-item__placeholder">
                                        <span>Невідомий формат</span>
                                    </div>
                                }
                            </div>

                            <div class="cv-card-item__body">
                                <h3 class="cv-card-item__title">Резюме #@item.Id</h3>
                                
                                <div class="cv-trash-timer">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span class="cv-trash-timer__text">
                                        @item.DeletionNotice
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </main>
</div>