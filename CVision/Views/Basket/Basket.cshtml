@using CVision.Helpers
@model CVision.Models.ViewModels.CVBasketViewModels.CVBasketViewModel

@{
    ViewData["Title"] = "Кошик";
    ViewData["DashboardCurrentPage"] = "Basket";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HubUser.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CVGallery.css" asp-append-version="true" />
}

<div class="dashboard-page dashboard-page--hub">
    <div class="dashboard-page__gradient"></div>
    <partial name="~/Views/Shared/_DashboardHeader.cshtml" />

    <main class="hub">
        <div class="cv-gallery">
            <div class="cv-gallery__header" style="margin-bottom: 2rem;">
                <h2 style="font-weight: 700; color: #2c1f1b;">Мій кошик</h2>
                <p style="color: #7a6560; font-size: 0.9rem;">Файли тут зберігаються до повного видалення. Ви можете переглянути їх перед очищенням.</p>
            </div>

            @if (Model?.Items == null || !Model.Items.Any())
            {
                <div class="cv-gallery__empty">
                    <div class="cv-gallery__empty-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                    </div>
                    <div class="cv-gallery__empty-title">Кошик порожній</div>
                </div>
            }
            else
            {
                <div class="cv-gallery__grid">
                    @foreach (var item in Model.Items)
                    {
                        <div class="cv-card-item" style="opacity: 0.85; border: 1px dashed #f0d8d1;">
                            <div class="cv-card-item__preview" style="filter: grayscale(0.5);">
                                @{
                                    var fileUrl = item.FilePath;
                                }

                                @if (FileUtils.IsImage(fileUrl))
                                {
                                    <img src="@fileUrl" class="img-fluid"/>
                                }
                                else if (FileUtils.IsDocx(fileUrl))
                                {
                                    var encodedUrl = System.Net.WebUtility.UrlEncode(fileUrl);
                                    <iframe src="https://view.officeapps.live.com/op/embed.aspx?src=@encodedUrl"></iframe>
                                }
                                else if (FileUtils.IsPdf(fileUrl))
                                {
                                    <iframe src="@fileUrl#toolbar=0"></iframe>
                                }
                            </div>

                            <div class="cv-card-item__body">
                                <h3 class="cv-card-item__title">Резюме #@item.Id</h3>
                                
                                <div class="cv-trash-timer" style="display: flex; align-items: center; gap: 5px; margin-top: 8px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c47a6a" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span style="color: #c47a6a; font-size: 0.75rem; font-weight: 600;">
                                        @item.DeletionNotice
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </main>
</div>